# Copy to cloud/env.sh and replace the first two values.
# BUCKET is a globally unique bucket NAME, without gs://.
export PROJECT_ID="YOUR_GCP_PROJECT_ID"
export BUCKET="YOUR_GLOBALLY_UNIQUE_RAINFALL_BUCKET"
export REGION="asia-southeast1"
export CLUSTER="rainfall-spark"
export NETWORK="rainfall-vpc"
export SUBNET="rainfall-subnet"
export SUBNET_RANGE="10.23.0.0/24"
export SA_NAME="rainfall-dataproc"
export IMAGE_VERSION="2.2.87-debian12"
export MASTER_MACHINE="e2-standard-4"
export WORKER_MACHINE="e2-standard-4"
export NUM_WORKERS="2"
export BOOT_DISK_GB="80"
export DELETE_MAX_IDLE="60m"
export DELETE_MAX_AGE="12h"
export RUN_ID="run01"

